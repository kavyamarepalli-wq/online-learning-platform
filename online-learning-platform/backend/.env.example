# Copy this file to ".env" for local development. Never commit the real .env file.

# development | production
APP_ENV=development

# Long random string. Required in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Leave empty to use SQLite (backend/instance/learnsphere.db).
# PostgreSQL example: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Public address of the frontend when it is hosted separately (CORS and certificate links).
# Leave empty when this server also serves the website. localhost:5173 is always allowed
# in development.
FRONTEND_URL=
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=
# Public address of this API. Leave empty to detect it from each request.
PUBLIC_API_URL=

# File storage: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=
MAX_UPLOAD_MB=100

# Needed only when STORAGE_BACKEND=s3 (AWS S3, Supabase Storage, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# If both are set and no administrator exists, one is created on start-up.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Number of reverse proxies in front of the app (use 1 on Render)
TRUSTED_PROXIES=0
TOKEN_HOURS=24
